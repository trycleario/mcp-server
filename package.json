{
  "name": "@trycleario/mcp-server",
  "version": "1.0.7",
  "description": "TryClear for agents: check a picture before acting on it. TryClear reads the picture it's given and never visits a link.",
  "type": "module",
  "bin": {
    "mcp-server": "src/main.mjs",
    "tryclear-mcp": "src/main.mjs"
  },
  "files": [
    "src",
    "README.md",
    "BREAKING_CHANGES.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "start": "node src/main.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@hono/node-server": "1.19.17"
  },
  "keywords": [
    "mcp",
    "tryclear",
    "security",
    "phishing",
    "scam",
    "image",
    "agents"
  ],
  "homepage": "https://github.com/trycleario/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trycleario/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/trycleario/mcp-server/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
